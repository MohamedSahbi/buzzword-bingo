{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && data.child('meta/hostId').val() === auth.uid",
        ".validate": "$roomCode.matches(/^[A-Z2-9]{6}$/)",
        "meta": {
          ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() === auth.uid) || data.child('hostId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['hostId','hostName','topic','mode','seed','createdAt'])",
          "hostId": {
            ".write": "auth != null && newData.val() === auth.uid && root.child('rooms/' + $roomCode + '/players/' + auth.uid + '/name').exists() && (!root.child('rooms/' + $roomCode + '/players/' + data.val() + '/name').exists() || (root.child('rooms/' + $roomCode + '/players/' + data.val() + '/online').val() === false && (!root.child('rooms/' + $roomCode + '/players/' + data.val() + '/lastSeen').exists() || root.child('rooms/' + $roomCode + '/players/' + data.val() + '/lastSeen').val() < now - 120000)))",
            ".validate": "newData.isString()"
          },
          "hostName": {
            ".write": "auth != null && newData.parent().child('hostId').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "lastActive": {
            ".write": "auth != null && root.child('rooms/' + $roomCode + '/players/' + auth.uid + '/name').exists()",
            ".validate": "newData.isNumber() && newData.val() <= now"
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($roomCode).child('meta').child('hostId').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 24)"
          }
        },
        "sharedMarks": {
          ".write": "auth != null && root.child('rooms').child($roomCode).child('meta').child('hostId').val() === auth.uid",
          "$index": {
            ".write": "auth != null",
            ".validate": "!newData.exists() || ($index.matches(/^([0-9]|1[0-9]|2[0-4])$/) && newData.hasChildren(['uid','name']))"
          }
        },
        "winners": {
          ".write": "auth != null && root.child('rooms').child($roomCode).child('meta').child('hostId').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "activity": {
          ".write": "auth != null && root.child('rooms').child($roomCode).child('meta').child('hostId').val() === auth.uid",
          "$event": {
            ".write": "auth != null && newData.child('uid').val() === auth.uid",
            ".validate": "!newData.exists() || (newData.child('text').isString() && newData.child('text').val().length <= 160)"
          }
        }
      }
    },
    "teams": {
      "$code": {
        ".read": "auth != null",
        ".validate": "$code.matches(/^[A-Z2-9]{6}$/)",
        "meta": {
          ".write": "auth != null && !data.exists() && newData.child('createdBy').val() === auth.uid",
          ".validate": "newData.hasChildren(['name','lang','createdBy','createdAt','expiresAt']) && newData.child('name').isString() && newData.child('name').val().length <= 30 && newData.child('lang').isString() && newData.child('lang').val().length <= 5 && newData.child('expiresAt').isNumber() && newData.child('expiresAt').val() <= now + 5184000000"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('teams/' + $code + '/meta').exists()",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 24)",
            "doors": {
              "$door": {
                ".validate": "$door.matches(/^([1-9]|[12][0-9]|3[01])$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
              }
            },
            "practice": {
              "$door": {
                ".validate": "$door.matches(/^([1-9]|[12][0-9]|3[01])$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
              }
            },
            "ghosts": {
              "$door": {
                ".validate": "$door.matches(/^p?([1-9]|[12][0-9]|3[01])$/) && newData.isString() && newData.val().length <= 1500 && newData.val().matches(/^[0-9:,-]*$/)"
              }
            }
          }
        }
      }
    },
    "live": {
      "$code": {
        ".read": "auth != null",
        ".validate": "$code.matches(/^[A-Z2-9]{6}$/)",
        "meta": {
          ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
          ".validate": "newData.hasChildren(['host','cal','door','createdAt']) && newData.child('cal').isString() && newData.child('cal').val().length <= 5 && newData.child('door').isNumber() && newData.child('door').val() >= 1 && newData.child('door').val() <= 31 && (!newData.child('startAt').exists() || newData.child('startAt').isNumber())"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('live/' + $code + '/meta').exists()",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('pts').isNumber() && newData.child('pts').val() >= 0 && newData.child('pts').val() <= 20000 && newData.child('found').isNumber() && newData.child('found').val() <= 20)"
          }
        }
      }
    },
    "advent": {
      "$cal": {
        "$year": {
          "meta": {
            ".read": true
          },
          "doors": {
            "$n": {
              ".read": "root.child('advent').child($cal).child($year).child('meta').child('release').child($n).val() <= now"
            }
          }
        }
      }
    },
    "predict": {
      "$code": {
        ".validate": "$code.matches(/^[A-Z2-9]{6}$/)",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() === auth.uid) || data.child('hostId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['hostId','hostName','title','state','createdAt','expiresAt']) && newData.child('expiresAt').isNumber() && newData.child('expiresAt').val() <= now + 2592000000 && newData.child('hostName').isString() && newData.child('hostName').val().length <= 24 && newData.child('title').isString() && newData.child('title').val().length <= 80 && (newData.child('state').val() === 'collect' || newData.child('state').val() === 'live' || newData.child('state').val() === 'done')"
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('predict').child($code).child('meta').exists()",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 24)"
          }
        },
        "cards": {
          ".read": "auth != null && root.child('predict').child($code).child('meta').child('state').val() !== 'collect'",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('predict').child($code).child('meta').child('state').val() === 'collect'",
            "$i": {
              ".validate": "$i.matches(/^[0-8]$/) && newData.isString() && newData.val().length <= 60"
            }
          }
        },
        "claims": {
          ".read": "auth != null",
          "$cid": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('predict').child($code).child('meta').child('state').val() === 'live'",
            ".validate": "newData.hasChildren(['uid','idx','at']) && newData.child('idx').isNumber() && newData.child('idx').val() >= 0 && newData.child('idx').val() <= 8"
          }
        },
        "votes": {
          ".read": "auth != null",
          "$cid": {
            "$voter": {
              ".write": "auth != null && auth.uid === $voter && root.child('predict').child($code).child('meta').child('state').val() === 'live' && root.child('predict').child($code).child('claims').child($cid).exists()",
              ".validate": "newData.val() === 1 || newData.val() === -1"
            }
          }
        }
      }
    }
  }
}
